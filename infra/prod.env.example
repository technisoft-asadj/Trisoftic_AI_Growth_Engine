# Copy to infra/prod.env (git-ignored) and fill in. Never commit real values.
POSTGRES_PASSWORD=
# Long random string; signs booking/unsubscribe links. Changing it invalidates links already sent.
LINK_SECRET=
# Public https address people reach the site on, no trailing slash.
PUBLIC_BASE_URL=https://growth.example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true only for a one-person team (otherwise nobody can approve their own request).
ALLOW_SELF_APPROVAL=false
WEB_PORT=8080

# Optional integrations; leave blank to keep them off.
EMAIL_FOOTER_TEXT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# AI: pick one provider and set its key (Bedrock uses the AWS values below instead).
AI_PROVIDER=Anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Where problems and the weekly report are emailed (needs SMTP_* above). Optional.
OWNER_EMAIL=
